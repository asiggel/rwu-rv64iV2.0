#===============================================================================
# 05_rv64_pv.tcl
#
# Physical verification of cc_chip_top (X-FAB XH018): writes the control
# files for DRC and LVS (incl. ERC) with Pegasus or Calibre. Runs in tclsh,
# normally through scripts/pv/pv.sh; writes into the current directory
# (build_pv/, never in git: X-FAB paths and switches).
#
# The X-FAB rule decks stay untouched. Each control file sets the inputs
# (layout, source netlist, report files), the deck switches (#DEFINE) and
# then includes the deck:
#
#   drc_<n>.ctl   one DRC run per deck in DRC_RULES (e.g. main + antenna)
#   lvs.ctl       LVS with ERC: GDS against the LVS netlist from Innovus;
#                 supply nets VDD/VDDO and GND/GNDO by the pad labels that
#                 02c_rv64_gds.tcl writes into the GDS
#
# Pegasus (PVL) reads the Verilog netlist itself, together with the CDL of
# the cells. Calibre (SVRF) needs SPICE: pv.sh converts the netlist with
# v2lvs into cc_chip_top_lvs.sp, which includes the cell CDL.
#
# Usage: tclsh 05_rv64_pv.tcl <pegasus|calibre> <gds> <lvs_source>
#        (lvs_source: cc_chip_top_lvs.v for Pegasus, the .sp for Calibre)
#
# From $XFAB_PATHS: DRC_RULES, LVS_RULES, PV_SWITCHES, CDL_FILES.
# VERIFY-LAB: the statement names (PVL for Pegasus in particular), and
# whether the X-FAB decks set layout/source paths themselves -- then the
# deck has to be told via its own variables instead (see its header).
#===============================================================================

set DESIGN_TOP cc_chip_top

if {$argc != 3} {
  puts stderr "usage: tclsh 05_rv64_pv.tcl <pegasus|calibre> <gds> <lvs_source>"
  exit 2
}
lassign $argv TOOL GDS SRC
set GDS [file normalize $GDS]
set SRC [file normalize $SRC]
if {$TOOL ni {pegasus calibre}} {
  puts stderr "tool must be pegasus or calibre, not '$TOOL'"
  exit 2
}

if {![info exists ::env(XFAB_PATHS)] || ![file readable $::env(XFAB_PATHS)]} {
  puts stderr "XFAB_PATHS must point to the local X-FAB path file (see xh018_paths_template.tcl)"
  exit 2
}
source $::env(XFAB_PATHS)
if {![info exists PV_SWITCHES]} { set PV_SWITCHES [list] }

foreach f [concat $DRC_RULES [list $LVS_RULES] $CDL_FILES] {
  if {![file readable $f]} {
    puts stderr "physical verification input not readable: $f"
    exit 2
  }
}

proc header {fd} {
  puts $fd "// generated by 05_rv64_pv.tcl -- holds X-FAB paths, never commit"
}
proc switches {fd} {
  foreach sw $::PV_SWITCHES { puts $fd "#DEFINE $sw" }
}

# ------------------------------------------------------------------------
# DRC: one control file per deck
# ------------------------------------------------------------------------
set n 0
foreach deck $DRC_RULES {
  incr n
  set fd [open drc_$n.ctl w]
  header $fd
  if {$TOOL eq "calibre"} {
    puts $fd "LAYOUT PATH \"$GDS\""
    puts $fd "LAYOUT PRIMARY \"$DESIGN_TOP\""
    puts $fd "LAYOUT SYSTEM GDSII"
    puts $fd "DRC RESULTS DATABASE \"drc_$n.results\" ASCII"
    puts $fd "DRC SUMMARY REPORT \"drc_$n.summary\" REPLACE HIER"
    puts $fd "DRC MAXIMUM RESULTS ALL"
    switches $fd
    puts $fd "INCLUDE \"[file normalize $deck]\""
  } else {
    puts $fd "layout_path \"$GDS\" gdsii;"
    puts $fd "layout_primary \"$DESIGN_TOP\";"
    puts $fd "results_db -drc \"drc_$n.results\" -ascii;"
    puts $fd "report_summary -drc \"drc_$n.summary\" -replace;"
    switches $fd
    puts $fd "include \"[file normalize $deck]\";"
  }
  close $fd
}

# ------------------------------------------------------------------------
# LVS + ERC
# ------------------------------------------------------------------------
set fd [open lvs.ctl w]
header $fd
if {$TOOL eq "calibre"} {
  puts $fd "LAYOUT PATH \"$GDS\""
  puts $fd "LAYOUT PRIMARY \"$DESIGN_TOP\""
  puts $fd "LAYOUT SYSTEM GDSII"
  puts $fd "SOURCE PATH \"$SRC\""
  puts $fd "SOURCE PRIMARY \"$DESIGN_TOP\""
  puts $fd "SOURCE SYSTEM SPICE"
  puts $fd "LVS REPORT \"lvs.report\""
  puts $fd "LVS REPORT OPTION S"
  puts $fd "ERC RESULTS DATABASE \"erc.results\" ASCII"
  puts $fd "ERC SUMMARY REPORT \"erc.summary\" REPLACE HIER"
  puts $fd "MASK SVDB DIRECTORY \"svdb\" QUERY"
  puts $fd "LVS POWER NAME \"VDD\" \"VDDO\""
  puts $fd "LVS GROUND NAME \"GND\" \"GNDO\""
  switches $fd
  puts $fd "INCLUDE \"[file normalize $LVS_RULES]\""
} else {
  puts $fd "layout_path \"$GDS\" gdsii;"
  puts $fd "layout_primary \"$DESIGN_TOP\";"
  foreach c $CDL_FILES { puts $fd "schematic_path \"[file normalize $c]\" cdl;" }
  puts $fd "schematic_path \"$SRC\" verilog;"
  puts $fd "schematic_primary \"$DESIGN_TOP\";"
  puts $fd "report_lvs \"lvs.report\" -replace;"
  puts $fd "results_db -erc \"erc.results\" -ascii;"
  puts $fd "report_summary -erc \"erc.summary\" -replace;"
  puts $fd "lvs_power_name \"VDD\" \"VDDO\";"
  puts $fd "lvs_ground_name \"GND\" \"GNDO\";"
  switches $fd
  puts $fd "include \"[file normalize $LVS_RULES]\";"
}
close $fd

puts "05_rv64_pv: wrote [join [lsort [glob drc_*.ctl]] { }] lvs.ctl ($TOOL)"
