#===============================================================================
# 03a_rv64_quantus.tcl
#
# RC extraction of the routed cc_chip_top with Cadence Quantus (standalone).
# Quantus reads a command file (CCL), not Tcl. This script runs in tclsh,
# takes the X-FAB file locations from $XFAB_PATHS and writes into the current
# directory (build_quantus/, never in git: it holds X-FAB paths):
#
#   qrc/rc_{max,typ,min}/qrcTechFile     links to QRC_MAX / QRC_TYP / QRC_MIN
#   lib.defs                             Quantus technology library: one
#                                        technology "xh018", its corners are
#                                        the subdirectories of qrc/
#   quantus.ccl                          the extraction run
#
# The links give the corners the names of the RC corners in xh018_mmmc.tcl,
# so the SPEF files come out as cc_chip_top_rc_max.spef etc. and Tempus maps
# them with read_spef -rc_corner without any X-FAB name.
#
# Extraction: all nets, RC with coupling capacitances (Tempus SI needs them),
# temperature per corner as in xh018_mmmc.tcl.
#
# Usage (normally through scripts/quantus/quantus_rcx.sh):
#   tclsh 03a_rv64_quantus.tcl <routed.def>
#   quantus -cmd quantus.ccl
#
# VERIFY-LAB (first run with Quantus 26.1):
#   - layer names in the technology LEF and in the qrcTechFile differ ->
#     set QRC_LAYERMAP in $XFAB_PATHS (pairs: LEF layer, QRC layer)
#   - output names with several corners: <file_name>_<corner>.spef expected;
#     quantus_rcx.sh lists what was written
#===============================================================================

set DESIGN_TOP cc_chip_top

if {$argc != 1} {
  puts stderr "usage: tclsh 03a_rv64_quantus.tcl <routed.def>"
  exit 2
}
set DEF_FILE [file normalize [lindex $argv 0]]

if {![info exists ::env(XFAB_PATHS)] || ![file readable $::env(XFAB_PATHS)]} {
  puts stderr "XFAB_PATHS must point to the local X-FAB path file (see xh018_paths_template.tcl)"
  exit 2
}
source $::env(XFAB_PATHS)
if {![info exists QRC_LAYERMAP]} { set QRC_LAYERMAP [list] }

# Corner name -> qrcTechFile, temperature (as create_rc_corner in xh018_mmmc.tcl)
set CORNERS [list rc_max $QRC_MAX 125  rc_typ $QRC_TYP 25  rc_min $QRC_MIN -40]

file delete -force qrc
file mkdir qrc
set names {}
set temps {}
foreach {name qrc temp} $CORNERS {
  if {![file readable $qrc]} {
    puts stderr "QRC tech file for $name not readable: $qrc"
    exit 2
  }
  # Quantus looks for <technology dir>/<corner>/qrcTechFile
  file mkdir qrc/$name
  file link -symbolic qrc/$name/qrcTechFile [file normalize $qrc]
  lappend names "\"$name\""
  lappend temps $temp
}

set fd [open lib.defs w]
puts $fd "DEFINE xh018 [file normalize qrc]"
close $fd

proc quoted {lst} {
  set out {}
  foreach e $lst { lappend out "\"[file normalize $e]\"" }
  return [join $out " "]
}

set fd [open quantus.ccl w]
puts $fd "# generated by 03a_rv64_quantus.tcl -- holds X-FAB paths, never commit"
puts $fd "input_db -type def \\"
puts $fd "    -design_file \"$DEF_FILE\" \\"
puts $fd "    -lef_file_list [quoted $LEF_FILES]"
puts $fd ""
puts $fd "process_technology \\"
puts $fd "    -technology_library_file \"[file normalize lib.defs]\" \\"
puts $fd "    -technology_name \"xh018\" \\"
puts $fd "    -technology_corner [join $names " "] \\"
puts $fd "    -temperature [join $temps " "]"
puts $fd ""
if {[llength $QRC_LAYERMAP] > 0} {
  puts $fd "extraction_setup \\"
  puts $fd "    -technology_layer_map [join $QRC_LAYERMAP " "]"
  puts $fd ""
}
puts $fd "extract \\"
puts $fd "    -selection \"all\" \\"
puts $fd "    -type \"rc_coupled\""
puts $fd ""
puts $fd "output_setup \\"
puts $fd "    -file_name \"$DESIGN_TOP\" \\"
puts $fd "    -compressed false"
puts $fd ""
puts $fd "output_db -type spef"
close $fd

puts "03a_rv64_quantus: wrote quantus.ccl, lib.defs, qrc/ (corners: rc_max rc_typ rc_min)"
